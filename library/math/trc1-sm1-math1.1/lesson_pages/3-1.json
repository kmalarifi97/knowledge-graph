    { "term_ar": "المثلث القائم الزاوية",  "term_en": "right triangle" },
    { "term_ar": "المثلث متساوي الأضلاع", "term_en": "equilateral triangle" },
    { "term_ar": "المثلث متساوي الساقين", "term_en": "isosceles triangle" },
    { "term_ar": "المثلث مختلف الأضلاع",  "term_en": "scalene triangle" }
  ],
  "common_misconceptions_ar": [
    "الاعتقاد أن المثلث متساوي الساقين يجب أن يكون حاد الزوايا؛ في حين يمكن أن يكون منفرج الزاوية أو قائم الزاوية.",
    "الخلط بين التصنيف بالزوايا والتصنيف بالأضلاع؛ إذ لكل مثلث وصفان مستقلان: أحدهما بحسب الزوايا والآخر بحسب الأضلاع.",
    "الظن أن المثلث متساوي الأضلاع لا يُعدّ متساوي الساقين؛ والصواب أنه يُعدّ كذلك لأن له ضلعين متساويين على الأقل.",
